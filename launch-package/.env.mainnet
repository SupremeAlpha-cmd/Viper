# Viper mainnet launch — pre-filled env (single-wallet plan: Bobby's launch wallet = deployer)
# Copy to the machine that runs the deploy, fill the two TODOs, then:
#   set -a && source launch-package/.env.mainnet && set +a && bash scripts/launch-mainnet.sh
#
# Signing: import Bobby's deployer key ONCE into foundry's encrypted keystore:
#   cast wallet import deployer --interactive
# (keystore password is asked at signing time; the raw key never sits in a file)

# --- TODO: from Bobby after the Pons launch ---
VIPER_TOKEN=TODO_BOBBY_VIPER_ADDRESS
REWARDS_POOL=TODO_BOBBY_WALLET_ADDRESS

# --- Pre-filled: team treasury (receives the 5% USDG game fees) ---
TREASURY=0x3A25eA32280f2D9516420bdeDd5b99f71E5799A5

# --- Pre-filled: verified mainnet USDG (Global Dollar, 6 decimals) ---
USDG_TOKEN=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# --- Pre-filled: network ---
MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
EXPECTED_CHAIN_ID=4663

# --- Pre-filled: locked entry tiers (USDG) ---
FEE_ARENA=30
FEE_SNAKE=20
FEE_CHESS=100
FEE_SQUAD=30
FEE_SL=20
# (Double or Nothing entry is fixed at $10 in-contract)

# --- Pre-filled: VIPER bonus reserve per game (2M x 5 = 10M total) ---
VIPER_RESERVE_PER_GAME=2000000

# --- One-click mode: set to 1 at launch time to skip the confirmation prompt ---
LAUNCH_YES=0

# --- Keystore account name (after `cast wallet import deployer --interactive`) ---
KEYSTORE_ACCOUNT=deployer
